{
  "manifest_version": 3,
  "name": "Infinity Dex Helper",
  "version": "1.0.0",
  "description": "Companion do InfinityMMO: dados de batalha ao vivo, melhor jogada e dano estimado, Pokédex e Meus Pokémon.",
  "action": {},
  "background": {
    "scripts": ["data/extension-storage.js", "background.js"]
  },
  "permissions": ["activeTab", "alarms", "scripting", "storage"],
  "host_permissions": ["*://infinitymmo.net/*", "*://*.infinitymmo.net/*", "https://raw.githubusercontent.com/gustavoard18-design/infinity-dex-helper/*"],
  "content_scripts": [
    {
      "matches": ["*://infinitymmo.net/*", "*://*.infinitymmo.net/*"],
      "js": ["hook.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["battle.html", "battle.js", "chart.html", "chart.js", "pixel-theme.css", "myPokemons.html", "myPokemons.js", "pokedex.html", "pokedex.js", "components/*.js", "components/*.css", "data/*.js", "icons/types/*.png", "icons/types/colored/*.png"],
      "matches": ["<all_urls>"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "infinity-dex-helper@gustavoard18",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
